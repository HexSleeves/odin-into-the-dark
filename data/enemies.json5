// Enemy definitions for Into the Depths
// Stats, visuals, and depth-based spawn weights
//
// detection_radius: how far the enemy can spot the player (default 10)
// memory_turns:     how many turns the enemy chases after losing sight (default 8)
//   - Low = forgetful (rats, bats)
//   - High = relentless (bosses, stalkers)
{
  enemies: [
    {
      id: "rat",
      name: "Rat",
      glyph: "r",
      color: [150, 120, 80, 255],
      hp: 3,
      attack: 2,
      quickness: 110,
      move_speed: 80,
      detection_radius: 6,
      memory_turns: 3,       // dumb — forgets quickly
    },
    {
      id: "miner_husk",
      name: "Miner Husk",
      glyph: "H",
      color: [180, 180, 160, 255],
      hp: 8,
      attack: 3,
      quickness: 90,
      move_speed: 110,
      detection_radius: 8,
      memory_turns: 6,       // moderate — shambling but persistent
    },
    {
      id: "cave_crawler",
      name: "Cave Crawler",
      glyph: "C",
      color: [100, 200, 100, 255],
      hp: 12,
      attack: 4,
      quickness: 100,
      move_speed: 100,
      detection_radius: 10,
      memory_turns: 10,      // smart hunter — sets webs and pursues
      ability: { type: "web", cooldown: 5, range: 1 },
    },
    {
      id: "cave_spider",
      name: "Cave Spider",
      glyph: "x",
      color: [60, 40, 70, 255],
      hp: 7,
      attack: 3,
      crit_chance: 5,
      quickness: 120,
      move_speed: 75,        // fast skittering
      detection_radius: 9,
      memory_turns: 8,       // persistent hunter — webs and pursues
      ability: { type: "web", cooldown: 4, range: 1 },
    },
    {
      id: "deep_watcher",
      name: "Deep Watcher",
      glyph: "W",
      color: [180, 50, 220, 255],
      hp: 18,
      attack: 6,
      quickness: 80,
      move_speed: 100,
      detection_radius: 14,
      memory_turns: 15,      // intelligent — long memory
      ability: { type: "freeze", cooldown: 4, range: 3 },
    },
    {
      id: "toxic_spore",
      name: "Toxic Spore",
      glyph: "S",
      color: [120, 200, 40, 255],
      hp: 5,
      attack: 2,
      quickness: 80,
      move_speed: 120,
      detection_radius: 5,
      memory_turns: 2,       // mindless — reacts only to proximity
      ability: { type: "poison_cloud", cooldown: 0, range: 0 },
    },
    {
      id: "shadow_stalker",
      name: "Shadow Stalker",
      glyph: "s",
      color: [80, 40, 120, 255],
      hp: 14,
      attack: 5,
      crit_chance: 10,
      quickness: 130,
      move_speed: 70,
      detection_radius: 16,
      memory_turns: 20,      // relentless predator — never gives up easily
      ability: { type: "teleport", cooldown: 3, range: 5 },
    },
    {
      id: "cave_bat",
      name: "Cave Bat",
      glyph: "b",
      color: [120, 90, 150, 255],
      hp: 5,
      attack: 3,
      crit_chance: 5,
      quickness: 150,
      move_speed: 60,
      detection_radius: 8,
      memory_turns: 4,       // skittish — loses interest fast
    },
    {
      id: "stone_thrower",
      name: "Stone Thrower",
      glyph: "T",
      color: [160, 140, 110, 255],
      hp: 9,
      attack: 4,
      quickness: 100,
      move_speed: 120,
      detection_radius: 12,
      memory_turns: 8,       // territorial — guards its area
      ability: { type: "ranged_shoot", cooldown: 2, range: 5 },
    },
    {
      id: "mine_lurker",
      name: "Mine Lurker",
      glyph: "L",
      color: [60, 60, 100, 255],
      hp: 18,
      attack: 8,
      crit_chance: 5,
      quickness: 80,
      move_speed: 100,
      detection_radius: 6,
      memory_turns: 25,      // patient ambusher — once triggered, never stops
      behavior: "lurker",
    },
    // ── Fleet additions ──────────────────────────────────────────────
    // Tier 1 (shallow, d1-3): low-threat fodder & skirmishers
    {
      id: "tunnel_grub",
      name: "Tunnel Grub",
      glyph: "g",
      color: [130, 110, 70, 255],
      hp: 6,
      attack: 2,
      quickness: 80,
      move_speed: 130,       // slow, bloated crawler
      detection_radius: 5,
      memory_turns: 3,       // mindless fodder
    },
    {
      id: "cave_kobold",
      name: "Cave Kobold",
      glyph: "k",
      color: [160, 140, 90, 255],
      hp: 5,
      attack: 3,
      crit_chance: 5,
      quickness: 110,
      move_speed: 90,
      detection_radius: 8,
      memory_turns: 6,       // opportunistic skirmisher
    },
    // Tier 2 (mid, d3-7): introduce control + bruiser pressure
    {
      id: "grasping_root",
      name: "Grasping Root",
      glyph: "Y",
      color: [80, 120, 60, 255],
      hp: 14,
      attack: 4,
      quickness: 70,
      move_speed: 150,       // near-rooted; controls space instead of chasing
      detection_radius: 12,
      memory_turns: 99,      // rooted sentinel — always aware once seen
      ability: { type: "pull", cooldown: 3, range: 5 },
    },
    {
      id: "flesh_brute",
      name: "Flesh Brute",
      glyph: "B",
      color: [180, 90, 90, 255],
      hp: 20,
      attack: 6,
      crit_chance: 5,
      quickness: 80,
      move_speed: 110,
      detection_radius: 8,
      memory_turns: 10,      // slow tank that ground-slams in melee
      ability: { type: "slam", cooldown: 4, range: 1, damage: 3 },
    },
    // Tier 3 (deep, d7-12): boss-grade mechanics on regular spawns
    {
      id: "frost_wraith",
      name: "Frost Wraith",
      glyph: "f",
      color: [120, 180, 230, 255],
      hp: 12,
      attack: 4,
      quickness: 120,
      move_speed: 80,        // fast, glassy freezer
      detection_radius: 14,
      memory_turns: 15,      // hunts and locks the player down
      ability: { type: "freeze", cooldown: 5, range: 4 },
    },
    {
      id: "void_caller",
      name: "Void Caller",
      glyph: "v",
      color: [120, 40, 160, 255],
      hp: 16,
      attack: 5,
      quickness: 90,
      move_speed: 100,
      detection_radius: 16,
      memory_turns: 18,      // smothers the light to hunt in the dark
      ability: { type: "darkness", cooldown: 5, range: 6 },
    },
    {
      id: "bone_archer",
      name: "Bone Archer",
      glyph: "a",
      color: [220, 210, 180, 255],
      hp: 11,
      attack: 4,
      crit_chance: 10,
      quickness: 100,
      move_speed: 110,
      detection_radius: 14,
      memory_turns: 12,      // ranged harasser — keeps distance and shoots
      ability: { type: "ranged_shoot", cooldown: 3, range: 6, damage: 4 },
    },
    // Bosses — high detection, long memory (effectively permanent)
    {
      id: "mine_guardian",
      name: "Mine Guardian",
      glyph: "G",
      color: [220, 180, 60, 255],
      hp: 50,
      attack: 8,
      crit_chance: 5,
      quickness: 80,
      move_speed: 100,
      detection_radius: 20,
      memory_turns: 99,
      ability: { type: "slam", cooldown: 3, range: 1, damage: 4 },
    },
    {
      id: "abyssal_lord",
      name: "Abyssal Lord",
      glyph: "A",
      color: [150, 30, 200, 255],
      hp: 75,
      attack: 10,
      quickness: 90,
      move_speed: 90,
      detection_radius: 25,
      memory_turns: 99,
      ability: { type: "darkness", cooldown: 4, range: 6 },
    },
    {
      id: "depth_king",
      name: "The Depth King",
      glyph: "K",
      color: [255, 50, 50, 255],
      hp: 100,
      attack: 14,
      crit_chance: 10,
      quickness: 100,
      move_speed: 100,
      detection_radius: 30,
      memory_turns: 99,
      ability: { type: "slam", cooldown: 3, range: 2, damage: 8 },
    },
  ],

  // Spawn tables: finer depth granularity for better pacing
  spawn_tables: [
    {
      // Depth 1: mostly rats, intro floor
      depth_min: 1, depth_max: 1,
      weights: [
        { id: "rat", weight: 60 },
        { id: "tunnel_grub", weight: 15 },
        { id: "miner_husk", weight: 10 },
        { id: "cave_bat", weight: 15 },
      ],
    },
    {
      // Depth 2: introduce husks and bats
      depth_min: 2, depth_max: 2,
      weights: [
        { id: "rat", weight: 35 },
        { id: "tunnel_grub", weight: 12 },
        { id: "cave_kobold", weight: 13 },
        { id: "miner_husk", weight: 25 },
        { id: "cave_bat", weight: 20 },
        { id: "cave_crawler", weight: 5 },
      ],
    },
    {
      // Depth 3-4: cave crawlers and spores appear
      depth_min: 3, depth_max: 4,
      weights: [
        { id: "rat", weight: 12 },
        { id: "cave_kobold", weight: 15 },
        { id: "miner_husk", weight: 20 },
        { id: "cave_bat", weight: 12 },
        { id: "cave_crawler", weight: 22 },
        { id: "cave_spider", weight: 15 },
        // grasping_root (pull) and flesh_brute (slam) moved to depth 5+ so the
