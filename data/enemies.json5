        { id: "toxic_spore", weight: 10 },
        { id: "stone_thrower", weight: 10 },
      ],
    },
    {
      // Depth 5-6: tougher mid-game
      depth_min: 5, depth_max: 6,
      weights: [
        { id: "miner_husk", weight: 12 },
        { id: "cave_crawler", weight: 20 },
        { id: "cave_spider", weight: 18 },
        { id: "grasping_root", weight: 12 },
        { id: "flesh_brute", weight: 12 },
        { id: "frost_wraith", weight: 8 },
        { id: "toxic_spore", weight: 12 },
        { id: "stone_thrower", weight: 18 },
        { id: "shadow_stalker", weight: 10 },
        { id: "deep_watcher", weight: 10 },
        { id: "mine_lurker", weight: 5 },
      ],
    },
    {
      // Depth 7-9: deep danger
      depth_min: 7, depth_max: 9,
      weights: [
        { id: "cave_crawler", weight: 12 },
        { id: "flesh_brute", weight: 12 },
        { id: "frost_wraith", weight: 15 },
        { id: "bone_archer", weight: 14 },
        { id: "void_caller", weight: 10 },
        { id: "toxic_spore", weight: 8 },
        { id: "stone_thrower", weight: 12 },
        { id: "shadow_stalker", weight: 18 },
        { id: "deep_watcher", weight: 18 },
        { id: "mine_lurker", weight: 13 },
      ],
    },
    {
      // Depth 10-12: endgame gauntlet
      depth_min: 10, depth_max: 12,
      weights: [
        { id: "shadow_stalker", weight: 22 },
        { id: "deep_watcher", weight: 22 },
        { id: "mine_lurker", weight: 18 },
        { id: "void_caller", weight: 15 },
        { id: "frost_wraith", weight: 13 },
        { id: "bone_archer", weight: 12 },
        { id: "stone_thrower", weight: 10 },
