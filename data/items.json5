// Item definitions for Into the Depths
// Stats, visuals, stacking, and use-effects
{
  items: [
    {
      id: "health_potion",
      name: "Health Potion",
      glyph: "!",
      color: [255, 80, 80, 255],
      stack_limit: 3,
      effect: {
        type: "heal",
        value: 8,
      },
    },
    {
      id: "torch",
      name: "Torch",
      glyph: "t",
      color: [255, 180, 50, 255],
      stack_limit: 1,
      effect: {
        type: "light_boost",
        value: 3,
        max_radius: 10,
      },
    },
  ],

  // Spawn weights per item when placing in rooms.
  // Equal weight = equal chance. These are relative.
  spawn_weights: [
    { id: "health_potion", weight: 50 },
    { id: "torch", weight: 50 },
  ],

  // Probability (0-100) that a room gets an item
  room_item_chance: 50,
}
