// (package main), the UI text layer (package ui), and the Clay overlays.

TITLE_OPTION_COUNT :: 5
TITLE_NEW_GAME :: 0
TITLE_CONTINUE :: 1
TITLE_HIGH_SCORES :: 2
TITLE_HELP :: 3
TITLE_QUIT :: 4

// Pause menu option indices and count. Shared by the pause input handler
// (package main) and the Clay pause overlay.
PAUSE_OPTION_COUNT :: 2
PAUSE_RESUME :: 0
PAUSE_QUIT_TO_TITLE :: 1
